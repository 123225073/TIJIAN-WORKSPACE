{
  "name": "elevator-workbench",
  "version": "0.12.0",
  "private": true,
  "description": "Elevator industry personal content workbench",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "desktop": "electron .",
    "package": "npm run build && powershell -NoProfile -File scripts/package-backend.ps1 && electron-builder --win --dir",
    "test": "powershell -NoProfile -File scripts/test-backend.ps1"
  },
  "dependencies": {
    "dompurify": "^3.2.0",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.0",
    "playwright-core": "1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "com.fengsha.elevator.workbench",
    "productName": "梯见工作台",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".runtime/backend-dist",
        "to": "backend"
      }
    ],
    "win": {
      "icon": "build/tijian.ico",
      "target": "nsis"
    }
  }
}
