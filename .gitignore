# Publish only application sources and maintained public documentation.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CHANGELOG.md
!/THIRD_PARTY_NOTICES.md
!/docs/
!/backend/
!/desktop/
!/src/
!/tests/
!/scripts/
!/build/
!/vendor/
!/package.json
!/package-lock.json
!/requirements.txt
!/tsconfig.json
!/vite.config.ts
!/index.html
!/启动梯见.cmd

node_modules/
.venv/
.runtime/
dist/
release/
local-data/
data/
workspaces/
__pycache__/
.pytest_cache/
.npm-cache/
.npmrc
.env
.env.*
*.py[cod]
*.sqlite*
*.db
*.db-*
*.key
*.pem
*.pfx
*.p12
*.log
*.out
*.err
*.zip
*.exe
*.dll
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.wav
*.mp3
*.m4a
**/.git/

